{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "EasySoftware.Abstractions/EasySoftware.Abstractions.csproj",
            "EasySoftware.MvvmMini.Core/EasySoftware.MvvmMini.Core.csproj",
            "EasySoftware.MvvmMini/EasySoftware.MvvmMini.csproj",
            "EasySoftware.WpfControls/EasySoftware.WpfControls.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "MvvmMini",
      "_appTitle": "MvvmMini",
      "_appFooter": "MvvmMini &middot; <a href=\"https://github.com/karapetyan-ashot/mvvm-mini\">GitHub</a>",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
