<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="clr-namespace:EasySoftware.WpfControls.Converters"
	xmlns:ctrl="clr-namespace:EasySoftware.WpfControls.Controls">

	<conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	<conv:NullToBoolConverter x:Key="NullToBoolConverter" />

	<Style TargetType="{x:Type ctrl:BusyIndicator}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:BusyIndicator}">
					<Grid>

						<!--  Your normal content  -->
						<ContentPresenter />

						<!--  Busy overlay  -->
						<Grid Background="#7F808080" Visibility="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
							<Border
								MinWidth="240"
								Padding="10"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Background="White"
								CornerRadius="6">

								<StackPanel Orientation="Vertical">
									<TextBlock
										Margin="0,4"
										HorizontalAlignment="Center"
										FontSize="14"
										FontWeight="SemiBold"
										Text="{TemplateBinding Message}">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Visible" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>

									<ProgressBar
										Height="20"
										Margin="0,4"
										IsIndeterminate="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToBoolConverter}}"
										Maximum="100"
										Minimum="0"
										Value="{TemplateBinding Progress}" />

									<TextBlock
										Margin="0,4"
										HorizontalAlignment="Right"
										Text="{TemplateBinding ProgressMessage}">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Visible" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding ProgressMessage, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>

									<Button
										MaxWidth="60"
										Margin="0,4"
										Command="{TemplateBinding CancelCommand}"
										Content="Cancel">
										<Button.Style>
											<Style TargetType="Button">
												<Setter Property="Visibility" Value="Visible" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding CancelCommand, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>
									</Button>
								</StackPanel>
							</Border>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>