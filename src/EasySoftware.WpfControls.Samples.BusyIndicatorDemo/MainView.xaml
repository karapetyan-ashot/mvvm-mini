<Window x:Class="EasySoftware.WpfControls.Samples.BusyIndicatorDemo.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySoftware.WpfControls.Samples.BusyIndicatorDemo"
		xmlns:ctrl="clr-namespace:EasySoftware.WpfControls.Controls;assembly=EasySoftware.WpfControls"
        mc:Ignorable="d"
		d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="MainView" Height="450" Width="800">
	<ctrl:BusyIndicator
		CancelCommand="{Binding CancelBusyCommand}"
		IsBusy="{Binding IsBusy}"
		Message="{Binding BusyMessage}"
		Progress="{Binding ProgressValue}"
		ProgressMessage="{Binding ProgressMessage}">
		<DockPanel LastChildFill="True">
			<StackPanel
				Margin="10"
				DockPanel.Dock="Top"
				Orientation="Horizontal">
				<Button
					Width="100"
					Margin="0,0,10,0"
					Command="{Binding ShowBusyCommand}"
					Content="Show busy indicator" />

				<CheckBox
					Margin="0,0,10,0"
					Content="Show Message"
					IsChecked="{Binding ShowMessage, Mode=TwoWay}" />
				<CheckBox
					Margin="0,0,10,0"
					Content="IsIndeterminate"
					IsChecked="{Binding IsIndeterminate, Mode=TwoWay}" />
				<CheckBox
					Margin="0,0,10,0"
					Content="ShowProgressMessage"
					IsChecked="{Binding ShowProgressMessage, Mode=TwoWay}" />
				<CheckBox
					Margin="0,0,10,0"
					Content="ShowCancelButton"
					IsChecked="{Binding ShowCancelButton, Mode=TwoWay}" />

			</StackPanel>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid
					Grid.Row="0"
					Grid.Column="0"
					Background="Yellow">
					<Button
						Width="100"
						Height="30"
						Command="{Binding TestCommand}"
						Content="Test Button" />
				</Grid>
				<Grid
					Grid.Row="0"
					Grid.Column="1"
					Background="Green" />
				<Grid
					Grid.Row="0"
					Grid.Column="2"
					Background="Blue" />
				<Grid
					Grid.Row="1"
					Grid.Column="0"
					Background="LightBlue" />
				<Grid
					Grid.Row="1"
					Grid.Column="1"
					Background="Transparent" />
				<Grid
					Grid.Row="1"
					Grid.Column="2"
					Background="LightGreen" />
				<Grid
					Grid.Row="2"
					Grid.Column="0"
					Background="LightPink" />
				<Grid
					Grid.Row="2"
					Grid.Column="1"
					Background="LightSalmon" />
				<Grid
					Grid.Row="2"
					Grid.Column="2"
					Background="LightBlue">
					<ListBox ItemsSource="{Binding Logs}" />
				</Grid>

			</Grid>
		</DockPanel>
	</ctrl:BusyIndicator>


</Window>